    {
      "Id": "Q14",
      "ExpectedCategory": "InCorpus",
      "ExpectedStatus": "Answered",
      "ActualStatus": "Answered",
      "StatusMatches": true,
      "ExpectedLanguage": "en",
      "DetectedLanguage": "en",
      "AnswerText": "To request a new destination for an agent, use the \u0060SetDestination\u0060 method to set a new destination point. This triggers the agent to calculate a new path. To read the remaining distance along the current path, access the \u0060remainingDistance\u0060 property, which returns the distance between the agent\u0027s current position and the destination on the current path. If the path is not yet computed or is unknown, \u0060remainingDistance\u0060 will have a value of infinity. Note that the path may not be available immediately; use \u0060pathPending\u0060 to check if a path is still being computed.",
      "CitationUrls": [
        "https://docs.unity3d.com/6000.3/Documentation/ScriptReference/AI.NavMeshAgent.SetDestination.html",
        "https://docs.unity3d.com/6000.3/Documentation/ScriptReference/AI.NavMeshAgent-remainingDistance.html"
      ],
      "ExpectedSourceUrls": [
        "https://docs.unity3d.com/6000.3/Documentation/ScriptReference/AI.NavMeshAgent.SetDestination.html",
        "https://docs.unity3d.com/6000.3/Documentation/ScriptReference/AI.NavMeshAgent-remainingDistance.html"
      ],
      "ExpectedFacts": [
        "SetDestination(Vector3 target) requests or updates a destination and starts calculating a new path.",
        "remainingDistance is the distance from the agent to the destination along the current path.",
        "remainingDistance is infinity when that distance is unknown."
      ]
    },
