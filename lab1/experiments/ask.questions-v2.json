    {
      "Id": "Q02",
      "ExpectedCategory": "InCorpus",
      "ExpectedStatus": "Answered",
      "ActualStatus": "Answered",
      "StatusMatches": true,
      "ExpectedLanguage": "en",
      "DetectedLanguage": "en",
      "AnswerText": "The property that tells me the path is still being computed is \u0060pathPending\u0060. The \u0060pathStatus\u0060 can report the states: PathInvalid, Partial, or Complete.",
      "CitationUrls": [
        "https://docs.unity3d.com/6000.3/Documentation/ScriptReference/AI.NavMeshAgent-pathPending.html",
        "https://docs.unity3d.com/6000.3/Documentation/ScriptReference/AI.NavMeshAgent-pathStatus.html",
        "https://docs.unity3d.com/6000.3/Documentation/ScriptReference/AI.NavMeshAgent.SetDestination.html"
      ],
      "ExpectedSourceUrls": [
        "https://docs.unity3d.com/6000.3/Documentation/ScriptReference/AI.NavMeshAgent.SetDestination.html",
        "https://docs.unity3d.com/6000.3/Documentation/ScriptReference/AI.NavMeshAgent-pathPending.html",
        "https://docs.unity3d.com/6000.3/Documentation/ScriptReference/AI.NavMeshAgent-pathStatus.html"
      ],
      "ExpectedFacts": [
        "SetDestination starts calculating a new path, which may take a few frames.",
        "pathPending is true while a path is being computed and is not ready.",
        "pathStatus reports whether the current path is complete, partial, or invalid."
      ]
    },
    {
      "Id": "Q03",
      "ExpectedCategory": "InCorpus",
      "ExpectedStatus": "Answered",
      "ActualStatus": "Answered",
      "StatusMatches": true,
      "ExpectedLanguage": "ru",
      "DetectedLanguage": "ru",
      "AnswerText": "\u0414\u0430, NavMeshAgent.autoBraking \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u0430\u0433\u0435\u043D\u0442\u0443 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438 \u0442\u043E\u0440\u043C\u043E\u0437\u0438\u0442\u044C, \u0447\u0442\u043E\u0431\u044B \u0438\u0437\u0431\u0435\u0436\u0430\u0442\u044C \u043F\u0440\u0435\u0432\u044B\u0448\u0435\u043D\u0438\u044F \u0446\u0435\u043B\u0438. \u0415\u0441\u043B\u0438 \u0441\u0432\u043E\u0439\u0441\u0442\u0432\u043E \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u043E \u0432 true, \u0430\u0433\u0435\u043D\u0442 \u0431\u0443\u0434\u0435\u0442 \u0442\u043E\u0440\u043C\u043E\u0437\u0438\u0442\u044C \u043F\u0440\u0438 \u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0435\u043D\u0438\u0438 \u043A \u0446\u0435\u043B\u0438, \u0447\u0442\u043E\u0431\u044B \u043D\u0435 \u043F\u0440\u0435\u0432\u044B\u0441\u0438\u0442\u044C \u0435\u0451 \u0438\u043B\u0438 \u0432\u0440\u0430\u0449\u0430\u0442\u044C\u0441\u044F \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u043E \u0432\u043E\u043A\u0440\u0443\u0433 \u0437\u043E\u043D\u044B \u0446\u0435\u043B\u0438.",
      "CitationUrls": [
        "https://docs.unity3d.com/6000.3/Documentation/ScriptReference/AI.NavMeshAgent-autoBraking.html",
        "https://docs.unity3d.com/6000.3/Documentation/ScriptReference/AI.NavMeshAgent.html"
      ],
      "ExpectedSourceUrls": [
        "https://docs.unity3d.com/6000.3/Documentation/ScriptReference/AI.NavMeshAgent-autoBraking.html"
      ],
      "ExpectedFacts": [
        "\u041F\u0440\u0438 true \u0430\u0433\u0435\u043D\u0442 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438 \u0442\u043E\u0440\u043C\u043E\u0437\u0438\u0442 \u043F\u043E \u043C\u0435\u0440\u0435 \u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0435\u043D\u0438\u044F \u043A \u0446\u0435\u043B\u0438.",
        "\u042D\u0442\u043E \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442 \u0438\u0437\u0431\u0435\u0436\u0430\u0442\u044C \u043F\u0440\u043E\u0441\u043A\u0430\u043A\u0438\u0432\u0430\u043D\u0438\u044F \u0446\u0435\u043B\u0435\u0432\u043E\u0439 \u0442\u043E\u0447\u043A\u0438 \u0438\u043B\u0438 \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0433\u043E \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F \u0432\u043E\u043A\u0440\u0443\u0433 \u043D\u0435\u0451."
      ]
