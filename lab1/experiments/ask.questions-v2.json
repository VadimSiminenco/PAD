    {
      "Id": "Q20",
      "ExpectedCategory": "InCorpus",
      "ExpectedStatus": "Answered",
      "ActualStatus": "Answered",
      "StatusMatches": true,
      "ExpectedLanguage": "en",
      "DetectedLanguage": "en",
      "AnswerText": "The property \u0060NavMeshAgent.hasPath\u0060 indicates whether the agent currently has a valid path to a destination. If \u0060hasPath\u0060 is true, the agent has a path that it is following; if false, it does not have a path. To distinguish between a path still being calculated and one the agent currently has, you can check \u0060hasPath\u0060. If \u0060hasPath\u0060 is false, it means no path is currently active or being calculated. However, if \u0060hasPath\u0060 is true, the path is active and being used. The \u0060CalculatePath\u0060 method initiates path calculation, but it does not guarantee that the path is immediately available\u2014so checking \u0060hasPath\u0060 after calling \u0060CalculatePath\u0060 will show whether the path has been successfully computed and stored. This property reflects the current state, not the pending state of calculation.",
      "CitationUrls": [
        "https://docs.unity3d.com/6000.3/Documentation/ScriptReference/AI.NavMeshAgent-hasPath.html",
        "https://docs.unity3d.com/6000.3/Documentation/ScriptReference/AI.NavMeshAgent.CalculatePath.html"
      ],
      "ExpectedSourceUrls": [
        "https://docs.unity3d.com/6000.3/Documentation/ScriptReference/AI.NavMeshAgent.SetDestination.html",
        "https://docs.unity3d.com/6000.3/Documentation/ScriptReference/AI.NavMeshAgent-pathPending.html",
        "https://docs.unity3d.com/6000.3/Documentation/ScriptReference/AI.NavMeshAgent-hasPath.html"
      ],
      "ExpectedFacts": [
        "SetDestination requests a destination and starts calculating a new path.",
        "pathPending indicates that a path is being computed but is not yet ready.",
        "hasPath indicates whether the agent currently has a path calculated to the desired destination."
      ]
    },
