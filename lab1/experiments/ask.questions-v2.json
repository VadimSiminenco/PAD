    {
      "Id": "Q04",
      "ExpectedCategory": "InCorpus",
      "ExpectedStatus": "Answered",
      "ActualStatus": "Answered",
      "StatusMatches": true,
      "ExpectedLanguage": "en",
      "DetectedLanguage": "en",
      "AnswerText": "NavMeshAgent.stoppingDistance controls the distance within which the agent should stop from the target position. A larger value gives the agent more room for manoeuvre at the end of the path, which can help avoid sudden braking, turning, or other unconvincing AI behaviour, especially when the agent is near the target.",
      "CitationUrls": [
        "https://docs.unity3d.com/6000.3/Documentation/ScriptReference/AI.NavMeshAgent-stoppingDistance.html",
        "https://docs.unity3d.com/6000.3/Documentation/ScriptReference/AI.NavMeshAgent.html"
      ],
      "ExpectedSourceUrls": [
        "https://docs.unity3d.com/6000.3/Documentation/ScriptReference/AI.NavMeshAgent-stoppingDistance.html"
      ],
      "ExpectedFacts": [
        "The agent stops within the configured distance from the target position.",
        "A larger stopping distance gives the agent more room to manoeuvre near the end of the path and may avoid sudden braking or turning."
      ]
    },
    {
